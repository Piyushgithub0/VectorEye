# VectorEye backend configuration.
# Copy this file to .env and fill in real values.

# PostgreSQL (Neon) connection string.
# Use the "prisma" pooled or "postgres" non-pooled URL for SQLAlchemy.
# Example: postgresql+psycopg://user:password@ep-xxx-pooler.aws-region.rds.amazonaws.com:5432/neondb
DATABASE_URL=

# Optional: force psycopg2 instead of psycopg3
# DATABASE_DRIVER=psycopg2

# CORS origins for the Vite dev server (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded orthophotos are stored
UPLOAD_DIR=uploads

# Where processed rasters/tiles are cached
STORAGE_DIR=storage

# ML model device: auto/cpu/cuda
ML_DEVICE=auto

# GPU batch inference: tiles processed per forward pass
ML_BATCH_SIZE=4

# Tile grid for full-image coverage (pixels)
TILE_SIZE=1024

# Overlap between adjacent tiles (0.0–0.5) to reduce edge artifacts
TILE_OVERLAP=0.15

# Mistral API key for analytical QC reports (optional)
MISTRAL_API_KEY=

# Mistral model for report narrative
MISTRAL_MODEL=mistral-small-latest

# Optional: run inference with real models (0/1). When 0, the pipeline
# falls back to the demo/mock feature generator so the UI is testable.
ML_ENABLED=0

# CARTO basemap API key (used by the frontend; backend does not need it)
# CARTO_API_KEY=